# ONNX Runtime optimized Dockerfile for Lambda API
# ~10x smaller than PyTorch version while producing identical embeddings

FROM python:3.11-slim-bookworm AS builder

ARG TARGETARCH=arm64
WORKDIR /var/task

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

# --- 1. Install Export Dependencies (System-wide, NOT in /install_dir) ---
# We install these just to run the conversion script. They WON'T be copied to the final image.
RUN pip install \
    "torch" \
    "sentence-transformers" \
    "optimum[onnxruntime]"

# --- 2. Export the Model ---
COPY deployment-helpers/download_model_onnx.py /tmp/download_model_onnx.py
# Save to a temporary folder so we can copy ONLY the model later
RUN python /tmp/download_model_onnx.py --save_path /tmp/model_output

# --- 3. Install Runtime Dependencies (Into /install_dir) ---
COPY requirements-api-onnx.txt .

# CRITICAL FIX: Removed --no-deps so FastAPI gets starlette, pydantic, etc.
RUN pip install \
    --platform manylinux2014_aarch64 \
    --target="/install_dir" \
    --only-binary=:all: \
    --no-cache-dir \
    -r requirements-api-onnx.txt

# --- 4. Prune Heavy Libraries ---
# Pip installed torch because 'optimum' needs it. We must delete it to save space.
# We also delete nvidia libs which are huge and useless on CPU Lambda.
RUN rm -rf \
    /install_dir/torch \
    /install_dir/nvidia \
    /install_dir/caffe2 \
    /install_dir/triton \
    /install_dir/sentence_transformers \
    /install_dir/__pycache__

# Remove compiled files to save space
RUN find /install_dir -name '__pycache__' -type d -exec rm -r {} +

# Stage 2: Runtime
FROM public.ecr.aws/lambda/python:3.11-arm64

WORKDIR /var/task

# Prevent ONNX Runtime from crashing on Lambda
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    MODEL_PATH=/var/task/model \
    EMBEDDING_CLIENT=onnx \
    ORT_LOGGING_LEVEL=4 \
    ORT_INTRA_OP_NUM_THREADS=1 \
    ORT_INTER_OP_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    OMP_WAIT_POLICY=PASSIVE \
    # NEW: Disable ONNX Runtime telemetry and CPU detection
    ORT_DISABLE_TELEMETRY=1 \
    # NEW: Force single-threaded execution
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

# Copy pure dependencies (No PyTorch)
COPY --from=builder /install_dir/ /var/task/

# Copy the exported model
COPY --from=builder /tmp/model_output /var/task/model

COPY app/ /var/task/app/

CMD ["app.main.handler"]