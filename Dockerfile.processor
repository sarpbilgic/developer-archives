FROM python:3.11-slim-bookworm AS builder

ARG TARGETARCH=arm64
WORKDIR /var/task

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

COPY requirements-processor.txt .

RUN python -m pip install --upgrade pip && \
    pip install \
        --platform manylinux2014_aarch64 \
        --target="/install_dir" \
        --only-binary=:all: \
        --no-cache-dir \
        torch \
        --extra-index-url ${TORCH_INDEX_URL} \
        -r requirements-processor.txt

COPY deployment-helpers/download_model.py /tmp/download_model.py

RUN PYTHONPATH=/install_dir:$PYTHONPATH python /tmp/download_model.py

FROM public.ecr.aws/lambda/python:3.11-arm64

WORKDIR /var/task

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    MODEL_PATH=/var/task/model

COPY --from=builder /install_dir/ /var/task/

COPY app/ /var/task/app/

CMD ["app.tasks.processor.handler"]
