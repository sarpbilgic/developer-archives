FROM public.ecr.aws/lambda/python:3.11-arm64
WORKDIR /var/task

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1

COPY requirements-processor.txt .
RUN python -m pip install --upgrade pip && \
    pip install --only-binary=:all: --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --only-binary=:all: --no-cache-dir -r requirements-processor.txt && \
    pip install --no-cache-dir sentence-transformers

# (Önerilen) modeli build aşamasında göm:
RUN python - << 'PY'
from sentence_transformers import SentenceTransformer
from huggingface_hub import snapshot_download
import os
import time

model_name = "sentence-transformers/all-mpnet-base-v2"
print(f"Downloading model: {model_name}")

# Retry logic for robust downloading
max_retries = 3
for attempt in range(max_retries):
    try:
        print(f"Download attempt {attempt + 1}/{max_retries}...")
        
        # First, download all model files with force_download
        snapshot_download(
            repo_id=model_name,
            cache_dir="/tmp/model_cache",
            force_download=True,
            resume_download=False
        )
        
        # Then load and save the model
        m = SentenceTransformer(
            model_name,
            cache_folder="/tmp/model_cache",
            device="cpu"
        )
        m.save("/opt/model")
        print("Model successfully saved to /opt/model")
        break
        
    except Exception as e:
        print(f"Attempt {attempt + 1} failed: {e}")
        if attempt < max_retries - 1:
            wait_time = (attempt + 1) * 10
            print(f"Waiting {wait_time}s before retry...")
            time.sleep(wait_time)
        else:
            print("All download attempts failed!")
            raise
PY

COPY app/ /var/task/app/

# Set environment variables for offline model usage
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    MODEL_PATH=/opt/model

CMD ["app.tasks.processor.handler"]
